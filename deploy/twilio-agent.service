# Twilio phone bridge — /etc/systemd/system/twilio-agent.service
# nginx already proxies https://voice.deepgram.com/twilio/ -> 127.0.0.1:8001
#
# Install:
#   sudo cp deploy/twilio-agent.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now twilio-agent
[Unit]
Description=Deepgram Telephone Voice Agent (Twilio bridge)
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/voice-agent
ExecStart=/home/ubuntu/voice-agent/.venv/bin/uvicorn twilio_server:app --host 127.0.0.1 --port 8001
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
