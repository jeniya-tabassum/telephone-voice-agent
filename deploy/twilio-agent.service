# SUPERSEDED — DO NOT INSTALL. Kept only as a record of the pre-Docker setup.
#
# The Twilio bridge now runs as the `twilio` service in docker-compose.yml
# (container voice-agent-twilio, published on 127.0.0.1:8001). Enabling this unit
# would either fail to bind 8001 against the running container or serve stale
# code from /home/ubuntu/voice-agent. To deploy or restart, use
# `docker compose build && docker compose up -d` — see README "Deploy".
[Unit]
Description=Deepgram Telephone Voice Agent (Twilio bridge)
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/voice-agent
ExecStart=/home/ubuntu/voice-agent/.venv/bin/uvicorn twilio_server:app --host 127.0.0.1 --port 8001
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
